# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local

# Overridden by docker-compose.yml for the app container; set this for
# running the backend directly on your host (outside Docker).
# Host port is 5544 (not 5432) to avoid colliding with a native PostgreSQL
# install — see the comment in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://agentgate:agentgate_local_dev@localhost:5544/agentgate

# --- AI provider (Section G/J: Google Gemini primary) ---
# The app boots WITHOUT a key as long as AI_ENABLED is false (Structured mode is
# unaffected). Set AI_ENABLED=true only with a real key — startup rejects blank.
# Key: https://aistudio.google.com/apikey  (Gemini has a free tier; limits are
# set by Google and can change — not guaranteed free).
AI_ENABLED=false
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=20
# Natural-language parse fails closed below this resolution confidence (0..1).
AI_PARSE_CONFIDENCE_THRESHOLD=0.6
# AI buyer agent budget: hard caps enforced by the loop, not the model.
AI_BUYER_MAX_STEPS=8
AI_BUYER_MAX_REQUEST_ACTIONS=3

# --- AI fallback (OPTIONAL, off by default) ---
# Gemini remains the default provider unconditionally. When AI_FALLBACK_ENABLED
# is true AND GROQ_API_KEY is set, a Gemini call that fails with a transient
# provider/availability error (HTTP 429/503/504, or a timeout) is retried
# once via the configured fallback model on Groq before failing closed.
# Leave AI_FALLBACK_ENABLED=false (or leave GROQ_API_KEY blank) to keep
# today's Gemini-only behaviour exactly as-is — see app/ai/groq_client.py.
# Key: https://console.groq.com/keys (Groq has a free tier; limits are set by
# Groq and can change — not guaranteed free).
AI_FALLBACK_ENABLED=false
GROQ_API_KEY=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Razorpay TEST MODE keys only. Never put live keys in this repo. ---
# The app boots fine with the placeholders below as long as RAZORPAY_ENABLED
# is false. Set it to true only with real test-mode credentials — startup then
# rejects blank / "placeholder" values.
RAZORPAY_ENABLED=false
# Dashboard > Settings > API Keys (make sure you're in Test Mode).
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
# Dashboard > Settings > Webhooks > (create a webhook) > Secret.
# This is DIFFERENT from RAZORPAY_KEY_SECRET above — do not reuse it.
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# --- Policy defaults (Section K: overridable per-merchant later) ---
DEFAULT_MAX_DISCOUNT_PCT=10.0
DEFAULT_APPROVAL_THRESHOLD_INR=5000.0

# --- Public URL (customer payment-return flow) ---
# The externally-reachable origin this deployment is served from, no trailing
# slash (e.g. https://agentgate.onrender.com, or http://localhost:8000 for
# full-stack docker-compose). Used only to build the Razorpay payment-link
# callback_url so a customer's browser is redirected back to AgentGate after
# paying. Optional — leave blank to disable the redirect-back; the payment and
# the webhook both still work, the customer just returns manually.
PUBLIC_BASE_URL=
